# Kopiera till `.env` och fyll i. Metro bakar in EXPO_PUBLIC_-variabler vid
# bygget, så de är läsbara i app-binären – lägg aldrig hemligheter här.
# App-hemligheten för nyckelhärledningen (§4) hör hemma i puzzleCrypto.ts.

# Var de publicerade pusslen ligger. Lämnas den tom använder appen det
# inbyggda exempelpusslet, så den går att köra direkt efter en klon.
EXPO_PUBLIC_PUZZLE_BASE_URL=

# Dev: tillåt okrypterade pussel från en dev-källa. Sätt aldrig i prod (§5).
EXPO_PUBLIC_ALLOW_PLAINTEXT=

# Dev: tillåt pussel med author "generated". Sätt aldrig i prod (§5).
EXPO_PUBLIC_ALLOW_GENERATED=
